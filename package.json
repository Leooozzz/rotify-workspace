{
  "name": "rotify-workspace",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "infra:up": "docker-compose up -d",
    "infra:down": "docker-compose down"
  },
  "allowScripts": {
    "@prisma/client@7.10.0": true,
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true
  }
}
